# ── Server ──────────────────────────────────────────────
PORT=5000
# Comma-separated list of allowed browser origins. Leave empty to allow any
# origin (fine locally; on Vercel the frontend and API share one origin).
CORS_ORIGIN=

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── MySQL ───────────────────────────────────────────────
# Either set DATABASE_URL (mysql://user:password@host:port/database) ...
DATABASE_URL=
# ... or the individual values below.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=artisoul
# Hosted MySQL (TiDB Cloud, Aiven, Railway...) needs TLS: set DB_SSL=true.
DB_SSL=false
# Optional: the provider's CA certificate (PEM; "\n" escapes are allowed).
DB_SSL_CA=
# Optional: pool size. Defaults to 3 on Vercel, 10 elsewhere.
DB_CONNECTION_LIMIT=

# ── Razorpay (test keys) — only needed for UPI/online checkout ──
TEST_KEY_ID=
TEST_KEY_SECRET=

# ── Vercel Blob — file uploads in production ────────────
# Added automatically when you connect a Blob store to the Vercel project.
# Leave empty locally to store uploads on disk in backend/uploads/.
BLOB_READ_WRITE_TOKEN=
